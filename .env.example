# SARAL-TN Configuration
# Copy to .env and fill in real values

# App Settings
APP_NAME=SARAL-TN
APP_ENV=development
DEBUG=True
SECRET_KEY=your-super-secret-key-here

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/saral_tn
REDIS_URL=redis://localhost:6379/0

# AWS S3 (File Storage)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_BUCKET_NAME=saral-tn-uploads
AWS_REGION=ap-south-1

# MoRTH Vahan API
VAHAN_API_URL=https://vahan.nic.in/api
VAHAN_API_KEY=your-vahan-api-key

# AI Model Paths
YOLO_MODEL_PATH=./models/yolov8n.pt
OCR_GPU=False

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your-razorpay-key
RAZORPAY_KEY_SECRET=your-razorpay-secret

# SMS/Email (Twilio/SendGrid)
TWILIO_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
SENDGRID_API_KEY=your-sendgrid-key

# Admin
ADMIN_EMAIL=admin@saral-tn.gov.in
